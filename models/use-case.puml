@startuml 用例图
left to right direction
skinparam packageStyle rectangle

actor "Agent 开发者" as Dev

rectangle "AgentTrace 系统" {
  usecase "UC-01 记录 Agent 运行" as UC01
  usecase "UC-02 回放与查看时间线" as UC02
  usecase "UC-03 查看统计总览" as UC03
  usecase "UC-04 定位失败步骤" as UC04
  usecase "离线 Mock 运行" as Mock
  usecase "按时间/状态过滤" as Filter
}

Dev --> UC01
Dev --> UC02
Dev --> UC03
Dev --> UC04

Mock .> UC01 : <<extend>>
Filter .> UC02 : <<extend>>
UC04 .> UC02 : <<extend>>
@enduml
